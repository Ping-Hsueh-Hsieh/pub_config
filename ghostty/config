# font

font-family = "JetBrainsMonoNL Nerd Font"
font-family-bold = "JetBrainsMonoNL Nerd Font"
font-family-italic = "JetBrainsMonoNL Nerd Font"
font-family-bold-italic = "JetBrainsMonoNL Nerd Font"

font-style = SemiBold
font-style-bold = ExtraBold
font-style-italic = Italic
font-style-bold-italic = ExtraBold Italic

font-size = 11.5
font-thicken = true

# cursor
shell-integration-features = no-cursor
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true

# alt
macos-option-as-alt = true

# theme
theme = cyberdream

maximize = true

# bell feature
bell-features = no-system
