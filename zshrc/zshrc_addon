# To use the bundled libunwind please use the following LDFLAGS:
#     LDFLAGS="-L/opt/homebrew/opt/llvm/lib/unwind -lunwind"

# zlib
export LDFLAGS="-L$HOMEBREW_PREFIX/opt/zlib/lib $LDFLAGS"
export CPPFLAGS="-I$HOMEBREW_PREFIX/opt/zlib/include $CPPFLAGS"
export PKG_CONFIG_PATH="$HOMEBREW_PREFIX/opt/zlib/lib/pkgconfig:$PKG_CONFIG_PATH"

# To use the bundled libc++ please use the following LDFLAGS:
export LDFLAGS="-L$HOMEBREW_PREFIX/opt/llvm/lib $LDFLAGS"
export LDFLAGS="-L$HOMEBREW_PREFIX/lib -L$HOMEBREW_PREFIX/opt/llvm/lib/c++ -L$HOMEBREW_PREFIX/opt/llvm/lib/unwind -lunwind $LDFLAGS"
export LDFLAGS="-L$HOME/.local/lib $LDFLAGS"

export CFLAGS="-I$HOMEBREW_PREFIX/opt/llvm/include"
export CPPFLAGS="-I$HOMEBREW_PREFIX/opt/llvm/include"

export CFLAGS="-I$HOME/.local/include $CFLAGS"
export CPPFLAGS="-I$HOME/.local/include $CPPFLAGS"

export PATH="$HOMEBREW_PREFIX/opt/llvm/bin:$PATH"

export CMAKE_PREFIX_PATH="$HOMEBREW_PREFIX:$HOMEBREW_PREFIX/opt/llvm:$CMAKE_PREFIX_PATH"

####################################################################################################
# === USER-LOCAL INSTALLS (no sudo) ===
export LOCAL_PREFIX="$HOME/.local"

export PATH="$LOCAL_PREFIX/bin:$PATH"
export PATH="$LOCAL_PREFIX/include:$PATH"
export PATH="$LOCAL_PREFIX/lib:$PATH"

# 1. CMake finds packages (mujoco, etc.)
export CMAKE_PREFIX_PATH="$LOCAL_PREFIX:$CMAKE_PREFIX_PATH"

# 2. Compiler finds headers
export CPATH="$LOCAL_PREFIX/include:$CPATH"
export CPATH="$HOMEBREW_PREFIX/include:$CPATH"
export CPATH="$HOMEBREW_PREFIX/opt/llvm/include:$CPATH"

# 3. Linker finds libraries
export LIBRARY_PATH="$LOCAL_PREFIX/lib:$LIBRARY_PATH"
export LD_LIBRARY_PATH="$LOCAL_PREFIX/lib:$LD_LIBRARY_PATH"
export LIBRARY_PATH="$HOMEBREW_PREFIX/lib:$LIBRARY_PATH"
export LD_LIBRARY_PATH="$HOMEBREW_PREFIX/lib:$LD_LIBRARY_PATH"

# 4. pkg-config finds .pc files
export PKG_CONFIG_PATH="$LOCAL_PREFIX/lib/pkgconfig:$PKG_CONFIG_PATH"

export DYLD_LIBRARY_PATH="$LOCAL_PREFIX/lib:$DYLD_LIBRARY_PATH"
####################################################################################################


